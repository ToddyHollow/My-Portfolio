---
import Layout from "@/layouts/Layout.astro";
import { projects, constructionProjects } from "@/lib/data";
import ProjectPage from "@/components/ProjectPage";

export function getStaticPaths() {
  const revitPaths = projects.map((project) => ({
    params: { slug: project.title.toLowerCase().replace(/\s+/g, "-") },
    props: { project },
  }));

  const constructionPaths = constructionProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));

  return [...revitPaths, ...constructionPaths];
}


const { project } = Astro.props;
---

<Layout>
  <ProjectPage
    client:only="react"
    title={project.title}
    description={project.description}
    images={project.images}
    pdf={project.pdf}
    disclaimer={project.disclaimer}
  />
</Layout>
